{
  "name": "@duskmoon-dev/el-markdown-input",
  "version": "1.9.2",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./register": {
      "types": "./dist/types/register.d.ts",
      "import": "./dist/esm/register.js",
      "require": "./dist/cjs/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "bun run clean",
    "build": "bun run build:esm && bun run build:cjs && bun run build:types",
    "build:esm": "bun run build.ts esm",
    "build:cjs": "bun run build.ts cjs",
    "build:types": "tsc --emitDeclarationOnly --outDir ./dist/types",
    "dev": "bun build ./src/index.ts --outdir ./dist/esm --format esm --sourcemap --external @duskmoon-dev/el-base --watch",
    "clean": "del-cli dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.ts' '*.json'",
    "format:check": "prettier --check 'src/**/*.ts' '*.json'",
    "lint": "eslint src",
    "lint:check": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "release": "bun publish",
    "release:dry-run": "bun publish --dry-run"
  },
  "dependencies": {
    "@duskmoon-dev/core": "1.20.3",
    "@duskmoon-dev/el-base": "1.9.2",
    "hast-util-sanitize": "5.0.2",
    "katex": "0.18.2",
    "rehype-prism-plus": "2.0.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "mermaid": "11.17.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json",
  "keywords": [
    "duskmoon-dev",
    "duskmoon",
    "custom-elements",
    "customelements",
    "web-components",
    "webcomponents",
    "html",
    "markdown",
    "editor",
    "markdown-editor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duskmoon-dev/duskmoon-elements.git"
  }
}
